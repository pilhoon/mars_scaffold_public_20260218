# ── Telegram Notifications ──────────────────────────────────
# Direct credential method (simplest)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Redis-backed credential method (alternative)
# TELEGRAM_REDIS_HOST=localhost
# TELEGRAM_REDIS_PORT=6379
# TELEGRAM_REDIS_DB=1
# TELEGRAM_REDIS_TOKEN_KEY=auth:telegram:token
# TELEGRAM_REDIS_CHAT_ID_KEY=auth:telegram:chat_id

# ── LLM Settings ───────────────────────────────────────────
# Override minimum interval (seconds) between LLM API calls
# LLM_MIN_CALL_INTERVAL_SEC=

# Codex CLI home directory (default: ~/.codex)
# CODEX_HOME=
